{
  "name": "world-digital-protest",
  "version": "1.0.0",
  "private": true,
  "description": "A world digital protest platform: synchronous, non-violent-by-protocol, no physical presence required, works online and offline, with live per-protest KPIs and YouTube live integration.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:geo": "node scripts/build-geo.mjs",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "reset": "node scripts/reset-db.js",
    "smoke": "node scripts/smoke.js",
    "broadcast:check": "node scripts/broadcast-check.js",
    "frame": "node scripts/frame.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pureimage": "^0.4.20",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "world-atlas": "^2.0.2"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
